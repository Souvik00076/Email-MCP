# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Email Configuration (add your email service credentials)
# These credentials are shared between SMTP (sending) and IMAP (reading)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# IMAP Configuration (for reading emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=True

#OAuth CLients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKEND_URL=

# Redis Configuration (Required - server will not start if Redis is unavailable)
REDIS_HOST=localhost                    # Redis server hostname
REDIS_PORT=6379                         # Redis server port
REDIS_DB=0                              # Database number (0-15, use 0 for single app)
REDIS_PASSWORD=                         # Leave empty for local dev, set for production
REDIS_TOKEN_TTL=600                     # Cache TTL in seconds (10 minutes = 600s)
REDIS_MAX_CONNECTIONS=10                # Connection pool size
