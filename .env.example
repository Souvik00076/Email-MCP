# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Email Configuration (add your email service credentials)
# These credentials are shared between SMTP (sending) and IMAP (reading)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# SMTP Configuration (for sending emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=True

# IMAP Configuration (for reading emails)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USE_SSL=True
